{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AKMessi/vex/schemas/scene-graph-v2.json",
  "title": "Vex SceneGraph v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "scene_graph_id",
    "signature",
    "source_program_id",
    "source_program_signature",
    "evidence_signature",
    "canvas",
    "design_system",
    "capability_manifest",
    "assets",
    "nodes",
    "relations",
    "motion_graph",
    "constraints",
    "quality_contract",
    "telemetry_contract"
  ],
  "properties": {
    "version": {"const": "vex-scene-graph-v2"},
    "scene_graph_id": {"type": "string", "minLength": 1, "maxLength": 96},
    "signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_program_id": {"type": "string", "minLength": 1, "maxLength": 96},
    "source_program_signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canvas": {"$ref": "#/$defs/canvas"},
    "design_system": {"$ref": "#/$defs/designSystem"},
    "capability_manifest": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/capability"}
    },
    "assets": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/asset"}
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/node"}
    },
    "relations": {
      "type": "array",
      "maxItems": 48,
      "items": {"$ref": "#/$defs/relation"}
    },
    "motion_graph": {"$ref": "#/$defs/motionGraph"},
    "constraints": {
      "type": "array",
      "maxItems": 48,
      "items": {"$ref": "#/$defs/constraint"}
    },
    "quality_contract": {"type": "object"},
    "telemetry_contract": {"$ref": "#/$defs/telemetryContract"}
  },
  "$defs": {
    "canvas": {
      "type": "object",
      "required": ["width", "height", "duration_sec", "fps", "safe_area"],
      "properties": {
        "width": {"type": "integer", "minimum": 320, "maximum": 7680},
        "height": {"type": "integer", "minimum": 240, "maximum": 7680},
        "duration_sec": {"type": "number", "minimum": 1.2, "maximum": 16},
        "fps": {"type": "number", "minimum": 15, "maximum": 120},
        "safe_area": {
          "type": "object",
          "additionalProperties": false,
          "required": ["top", "right", "bottom", "left"],
          "properties": {
            "top": {"type": "number", "minimum": 0, "maximum": 0.2},
            "right": {"type": "number", "minimum": 0, "maximum": 0.2},
            "bottom": {"type": "number", "minimum": 0, "maximum": 0.2},
            "left": {"type": "number", "minimum": 0, "maximum": 0.2}
          }
        }
      }
    },
    "designSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["palette", "typography", "material", "depth_model", "motif", "texture_strength"],
      "properties": {
        "palette": {"type": "object"},
        "typography": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "system",
            "font_family",
            "fallback_family",
            "title_weight",
            "body_weight",
            "minimum_font_px",
            "line_height",
            "letter_spacing_em"
          ],
          "properties": {
            "system": {"type": "string"},
            "font_family": {"type": "string"},
            "fallback_family": {"type": "string"},
            "title_weight": {"type": "integer", "minimum": 100, "maximum": 1000},
            "body_weight": {"type": "integer", "minimum": 100, "maximum": 1000},
            "minimum_font_px": {"type": "integer", "minimum": 12, "maximum": 72},
            "line_height": {"type": "number", "minimum": 0.8, "maximum": 2},
            "letter_spacing_em": {"type": "number", "minimum": -0.2, "maximum": 0.5}
          }
        },
        "material": {"type": "string"},
        "depth_model": {"type": "string"},
        "motif": {"type": "string"},
        "texture_strength": {"type": "number", "minimum": 0, "maximum": 0.35}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primitive", "backend", "fallback_backend", "motion_properties", "cost", "semantic"],
      "properties": {
        "primitive": {"type": "string", "minLength": 1, "maxLength": 64},
        "backend": {"enum": ["dom", "svg", "skia", "three", "rive", "lottie"]},
        "fallback_backend": {"enum": ["dom", "svg", "skia", "three", "rive", "lottie"]},
        "motion_properties": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "cost": {"type": "number", "minimum": 0.1, "maximum": 100},
        "semantic": {"type": "boolean"}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "node_id", "uri", "embedded", "content_hash", "provenance", "semantic_role"],
      "properties": {
        "asset_id": {"type": "string"},
        "node_id": {"type": "string"},
        "uri": {"type": "string"},
        "embedded": {"type": "boolean"},
        "content_hash": {"type": "string"},
        "provenance": {"type": "string"},
        "semantic_role": {"type": "string"}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["fact", "object", "relation"]},
        "id": {"type": "string"}
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height", "anchor", "z_index"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "anchor": {"enum": ["top_left", "center", "bottom_left", "bottom_right", "top_right"]},
        "z_index": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "parent_id",
        "primitive",
        "backend",
        "fallback_backend",
        "role",
        "binding",
        "decorative",
        "layout",
        "content",
        "style",
        "repeat",
        "telemetry"
      ],
      "properties": {
        "node_id": {"type": "string", "minLength": 1, "maxLength": 96},
        "parent_id": {"type": "string", "maxLength": 96},
        "primitive": {"type": "string", "minLength": 1, "maxLength": 64},
        "backend": {"enum": ["dom", "svg", "skia", "three", "rive", "lottie"]},
        "fallback_backend": {"enum": ["dom", "svg", "skia", "three", "rive", "lottie"]},
        "role": {"type": "string", "minLength": 1, "maxLength": 80},
        "binding": {"$ref": "#/$defs/binding"},
        "decorative": {"type": "boolean"},
        "layout": {"$ref": "#/$defs/layout"},
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "asset", "data"],
          "properties": {
            "text": {"type": "string", "maxLength": 240},
            "asset": {"type": "object"},
            "data": {}
          }
        },
        "style": {"type": "object"},
        "repeat": {"type": "integer", "minimum": 1, "maximum": 24},
        "telemetry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["measure_geometry", "measure_text", "semantic_probe"],
          "properties": {
            "measure_geometry": {"type": "boolean"},
            "measure_text": {"type": "boolean"},
            "semantic_probe": {"type": "boolean"}
          }
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_id",
        "source_id",
        "target_id",
        "type",
        "binding",
        "primitive",
        "backend",
        "routing",
        "style",
        "telemetry"
      ],
      "properties": {
        "relation_id": {"type": "string"},
        "source_id": {"type": "string"},
        "target_id": {"type": "string"},
        "type": {"type": "string"},
        "binding": {"$ref": "#/$defs/binding"},
        "primitive": {"const": "vector_path"},
        "backend": {"const": "svg"},
        "routing": {"enum": ["cubic", "direct", "orthogonal"]},
        "style": {"type": "object"},
        "telemetry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["measure_path", "verify_endpoints"],
          "properties": {
            "measure_path": {"type": "boolean"},
            "verify_endpoints": {"type": "boolean"}
          }
        }
      }
    },
    "keyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "value", "easing"],
      "properties": {
        "t": {"type": "number", "minimum": 0, "maximum": 1},
        "value": {
          "oneOf": [
            {"type": "number"},
            {"type": "string"},
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {"type": "number"}
            }
          ]
        },
        "easing": {"enum": ["ease_in", "ease_in_out", "ease_out", "linear", "spring_gentle", "spring_snappy"]}
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["track_id", "target_id", "property", "semantic_intent", "phase_id", "keyframes"],
      "properties": {
        "track_id": {"type": "string"},
        "target_id": {"type": "string"},
        "property": {"type": "string"},
        "semantic_intent": {"type": "string", "minLength": 1},
        "phase_id": {"type": "string"},
        "keyframes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "items": {"$ref": "#/$defs/keyframe"}
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase_id", "role", "start", "end", "job", "target_ids"],
      "properties": {
        "phase_id": {"type": "string"},
        "role": {"type": "string"},
        "start": {"type": "number", "minimum": 0, "maximum": 1},
        "end": {"type": "number", "minimum": 0, "maximum": 1},
        "job": {"type": "string"},
        "target_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependency_id", "source_phase_id", "target_phase_id", "type"],
      "properties": {
        "dependency_id": {"type": "string"},
        "source_phase_id": {"type": "string"},
        "target_phase_id": {"type": "string"},
        "type": {"const": "precedes"}
      }
    },
    "motionGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phases",
        "dependencies",
        "tracks",
        "reduced_motion_policy",
        "maximum_simultaneous_motion"
      ],
      "properties": {
        "phases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {"$ref": "#/$defs/phase"}
        },
        "dependencies": {
          "type": "array",
          "maxItems": 16,
          "items": {"$ref": "#/$defs/dependency"}
        },
        "tracks": {
          "type": "array",
          "maxItems": 144,
          "items": {"$ref": "#/$defs/track"}
        },
        "reduced_motion_policy": {"type": "string"},
        "maximum_simultaneous_motion": {"type": "integer", "minimum": 1, "maximum": 8}
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraint_id", "type", "targets", "axis", "priority", "gap", "padding"],
      "properties": {
        "constraint_id": {"type": "string"},
        "type": {"enum": ["align", "aspect_ratio", "avoid_overlap", "contain", "distribute", "keep_inside_safe_area", "minimum_gap", "pin"]},
        "targets": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "axis": {"enum": ["both", "x", "y"]},
        "priority": {"type": "integer", "minimum": 1, "maximum": 1000},
        "gap": {"type": "number", "minimum": 0, "maximum": 0.5},
        "padding": {"type": "number", "minimum": 0, "maximum": 0.25}
      }
    },
    "telemetryContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_times", "required_probes", "fail_on"],
      "properties": {
        "sample_times": {
          "type": "array",
          "minItems": 3,
          "maxItems": 32,
          "items": {"type": "number", "minimum": 0, "maximum": 1},
          "uniqueItems": true
        },
        "required_probes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "fail_on": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    }
  }
}
